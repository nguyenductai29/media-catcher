{
  "name": "mediavault",
  "productName": "MediaVault",
  "description": "Windows media browser, local library and Google Drive backup",
  "author": "nguyenductai29",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenductai29/media-catcher.git"
  },
  "version": "0.1.0",
  "main": "dist-electron/main.cjs",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:web && npm run build:desktop",
    "build:web": "vite build",
    "build:desktop": "vite build --config vite.desktop.config.ts && node scripts/build-electron.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "setup:ytdlp": "node scripts/setup-ytdlp.mjs",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.mjs",
    "test:desktop": "npm run build:desktop && node scripts/smoke-electron.mjs",
    "package:dir": "npm run build:desktop && node scripts/prepare-packaging.mjs && electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "package:win": "npm run build:desktop && node scripts/prepare-packaging.mjs && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "test:packaging": "node --test scripts/prepare-packaging.test.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "test:installer": "node scripts/test-installer.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:serve": "node scripts/serve-fixtures.mjs",
    "test:fixtures": "node --test scripts/fixtures.test.mjs",
    "test:drive:manual": "node scripts/test-drive-manual.mjs",
    "test:binary-setup": "node --test electron/services/setup-ytdlp.test.mjs electron/services/setup-ffmpeg.test.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "6.8.9",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^2.25.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.63.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "yauzl": "^3.4.0"
  }
}
