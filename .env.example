# Electron Main only. Never use a VITE_ prefix for OAuth configuration.
# Create an OAuth client with application type "Desktop app" in Google Cloud.
GOOGLE_CLIENT_ID=replace-with-desktop-client-id.apps.googleusercontent.com
# Optional public desktop-client credential, if required by your Google client.
# A desktop application cannot keep this value confidential.
GOOGLE_CLIENT_SECRET=
# Copy to .env.local, replace placeholders, then explicitly load it:
# node --env-file=.env.local scripts/electron-dev.mjs
# The installed app reads these at launch; building does not embed them.
# Shortcut/Windows startup setup: docs/final-setup-and-test.md section 3.
